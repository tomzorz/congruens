{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "bash": {
      "git commit *": "allow",
      "git commit": "allow",
      "git add *": "allow",
      "git add .": "allow",
      "git checkout *": "deny",
      "git switch *": "allow",
      "git branch -d *": "deny",
      "git branch -D *": "deny",
      "git branch --delete *": "deny",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "deny",
      "git reset --hard": "deny",
      "git reset *": "ask",
      "git reset": "ask",
      "git revert *": "ask",
      "git cherry-pick *": "ask",
      "git stash": "allow",
      "git stash drop *": "deny",
      "git stash pop *": "allow",
      "git stash apply *": "allow",
      "git stash show *": "allow",
      "git stash clear": "deny",
      "git stash push *": "allow",
      "git stash save *": "ask",
      "git clean *": "deny",
      "git restore --staged *": "allow",
      "git restore *": "ask",
      "git push --force*": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push * --force*": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "git push --delete *": "deny",
      "git push * --delete *": "deny",
      "git push --mirror*": "deny",
      "git push *": "allow",
      "git push": "allow",
      "git pull *": "ask",
      "git pull": "ask",
      "git fetch *": "allow",
      "git fetch": "allow",
      "git clone *": "ask",
      "git init *": "deny",
      "git init": "deny",
      "git rm *": "ask",
      "git mv *": "ask",
      "git tag -d *": "deny",
      "git tag --delete *": "deny",
      "git tag -a *": "deny",
      "git tag -s *": "deny",
      "git reflog expire *": "deny",
      "git gc *": "deny",
      "git prune *": "deny",
      "git filter-branch *": "deny",
      "git update-ref *": "deny",
      "git replace *": "deny",
      "git notes *": "deny",
      "git config --global *": "deny",
      "git config --system *": "deny",
      "git config --unset *": "deny",
      "git config user.*": "deny",
      "git remote add *": "deny",
      "git remote remove *": "deny",
      "git remote rename *": "deny",
      "git remote set-url *": "deny",
      "gh repo delete*": "deny",
      "gh repo archive*": "deny",
      "gh repo unarchive*": "deny",
      "gh repo rename*": "deny",
      "gh repo edit * --visibility*": "deny",
      "gh repo edit --visibility*": "deny",
      "gh api -X DELETE*": "deny",
      "gh api --method DELETE*": "deny",
      "gh api * -X DELETE*": "deny",
      "gh api * --method DELETE*": "deny",
      "gh secret set*": "deny",
      "gh secret delete*": "deny",
      "gh variable set*": "deny",
      "gh variable delete*": "deny",
      "gh release delete*": "deny",
      "gh release delete-asset*": "deny",
      "gh ssh-key delete*": "deny",
      "gh gpg-key delete*": "deny",
      "gh auth logout*": "deny",
      "gh auth refresh*": "deny",
      "gh auth token*": "deny"
    }
  }
}
